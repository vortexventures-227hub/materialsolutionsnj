ADMIN_PASTE_QUEUE_TOKEN=replace-with-a-long-random-token

# Public phone CTA. Leave unset until the carrier/Retell/Telnyx path is proven green.
NEXT_PUBLIC_DAVID_PHONE_NUMBER=
NEXT_PUBLIC_DAVID_PHONE_LABEL=

# David customer lead Telegram alerts. Use David's bot token here, not Axis/Patch/Herm.
DAVID_LEAD_TELEGRAM_BOT_TOKEN=
DAVID_LEAD_TELEGRAM_CHAT_ID=

# Legacy/generic Telegram fallback. Prefer the David-specific keys above for customer leads.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# FSM (Material Solutions Portal) backend integration
NEXT_PUBLIC_BACKEND_URL=https://vortex-forklift-api-production.up.railway.app
# Must be an FSM/Railway JWT accepted as Authorization: Bearer by the Railway API.
BACKEND_API_KEY=***

# David runtime bridge (leave blank to keep website chat on local fallback)
DAVID_RUNTIME_URL=
DAVID_RUNTIME_SECRET=***
DAVID_WEB_CHAT_NOTIFICATIONS_ENABLED=false

# David outbound email restart guardrails. Keep David hard-stop active until Patch/owner
# confirms the approved sender allowlist and explicitly flips outbound email on.
SENDGRID_SENDER_ALLOWLIST=
SMTP_FROM_ADDRESS=
DAVID_EMAIL_DRY_RUN=true
DAVID_EMAIL_OUTBOUND_ENABLED=false
DAVID_EMAIL_RECIPIENT_ALLOWLIST=
