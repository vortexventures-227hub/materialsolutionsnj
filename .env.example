ADMIN_PASTE_QUEUE_TOKEN=replace-with-a-long-random-token

# Public phone CTA. Leave unset until the carrier/Retell/Telnyx path is proven green.
NEXT_PUBLIC_DAVID_PHONE_NUMBER=
NEXT_PUBLIC_DAVID_PHONE_LABEL=

# David customer lead Telegram alerts. Use David's bot token here, not Axis/Patch/Herm.
DAVID_LEAD_TELEGRAM_BOT_TOKEN=
DAVID_LEAD_TELEGRAM_CHAT_ID=

# Legacy/generic Telegram fallback. Prefer the David-specific keys above for customer leads.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# FSM (Material Solutions Portal) backend integration
NEXT_PUBLIC_BACKEND_URL=https://vortex-forklift-api-production.up.railway.app
BACKEND_API_KEY=

# David persistent memory scaffold (safe/off by default)
# Keep retrieval disabled until Patch approves schema/backend and production rollout.
DAVID_MEMORY_ENABLED=false
# Supported scaffold backends: test, supabase, zep. Use test unless explicitly approved.
DAVID_MEMORY_BACKEND=test
# Server-side cap for injected memory context; protects prompt size and accidental over-injection.
DAVID_MEMORY_MAX_CHARS=2200
# Writes are separately gated and must remain false until backend/schema approval.
DAVID_MEMORY_WRITE_ENABLED=false
