# Active storefront David path
GEMINI_API_KEY=your_gemini_key

# Legacy David chat route only
ANTHROPIC_API_KEY=sk_test_...

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Owner notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Active David path rate limiting
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Voice / avatar features
OPENAI_API_KEY=your_openai_key
OPENAI_TTS_MODEL=tts-1-hd
OPENAI_TTS_VOICE=onyx
SIMLI_API_KEY=your_simli_server_key
SIMLI_FACE_ID=your_simli_face_id
NEXT_PUBLIC_SIMLI_FACE_ID=your_public_simli_face_id

# Optional / secondary surfaces
ZEP_API_KEY=your_zep_key
NEXT_PUBLIC_BACKEND_URL=https://material-solutions-app.onrender.com
BACKEND_API_KEY=your_backend_api_key
MAX_DAILY_SESSIONS=100
MAX_DAILY_LLM_REQUESTS=5000
MAX_DAILY_TTS_CHARS=50000
